# FareLens Environment Configuration

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Data & Integrity Flags
DEMO_MODE_ENABLED="true"
DATA_FRESHNESS_MINUTES="15"
PREDICTION_MIN_SNAPSHOTS="5"

# Database Configuration (PostgreSQL / Supabase compatible)
DATABASE_URL="file:./dev.db" # Default fallback for local sqlite/in-memory store or "postgresql://user:pass@host:5432/farelens"

# Cache & Queues (Redis / Upstash)
REDIS_URL="redis://localhost:6379"

# Authentication & Sessions
AUTH_SECRET="farelens-super-secret-jwt-key-min-32-chars-length"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Notifications (Resend / AWS SES)
RESEND_API_KEY=""
EMAIL_FROM="FareLens Alerts <alerts@farelens.in>"

# Admin & Role Access (comma-separated admin emails)
ADMIN_EMAILS="admin@farelens.in,deepak@farelens.in"

# Provider Integrations (Set when official API credentials or affiliate keys are acquired)
# redBus Partner / Affiliate API
PROVIDER_REDBUS_API_KEY=""
PROVIDER_REDBUS_CLIENT_ID=""
PROVIDER_REDBUS_BASE_URL="https://api.redbus.in/v1"
PROVIDER_REDBUS_AFFILIATE_ID=""

# AbhiBus B2B / Affiliate API
PROVIDER_ABHIBUS_API_KEY=""
PROVIDER_ABHIBUS_SECRET=""
PROVIDER_ABHIBUS_BASE_URL="https://api.abhibus.com"
PROVIDER_ABHIBUS_AFFILIATE_ID=""

# MakeMyTrip Partner API
PROVIDER_MMT_PARTNER_KEY=""
PROVIDER_MMT_SECRET=""
PROVIDER_MMT_AFFILIATE_ID=""

# Goibibo Affiliate API
PROVIDER_GOIBIBO_API_KEY=""
PROVIDER_GOIBIBO_AFFILIATE_ID=""

# Paytm Bus Affiliate API
PROVIDER_PAYTM_CLIENT_ID=""
PROVIDER_PAYTM_SECRET=""
PROVIDER_PAYTM_AFFILIATE_ID=""

# Authorised B2B Bus Inventory Aggregator
PROVIDER_AGGREGATOR_BASE_URL=""
PROVIDER_AGGREGATOR_API_KEY=""
PROVIDER_AGGREGATOR_SECRET=""

# Statistical Prediction Service (FastAPI for Advanced Phase)
PREDICTION_SERVICE_URL="http://localhost:8000"
